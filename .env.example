# Copy this file to .env.local and fill in real values to use Supabase.
# Leave the placeholders as they are to run in local demo mode.
#
# Find both values in your Supabase project:
#   Project Settings -> API Keys (URL is under Project Settings -> Data API)
# Use the PUBLISHABLE key (older projects call it the "anon" key).
# NEVER put the secret / service_role key here: anything starting with
# VITE_ is visible to everyone who opens the website.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
